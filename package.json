{
  "name": "bloomai",
  "private": true,
  "version": "0.1.0",
  "description": "BloomAI - Local-first AI Desktop Assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-with-utf8-console.cjs",
    "build": "tsc --noEmit && vite build --config electron.vite.config.mts",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint ok\"",
    "db:migrate": "node scripts/db-migrate.js",
    "start:server": "tsx src/server/index.ts",
    "test:architecture": "vitest run src/server/architecture/dependency-boundaries.test.ts",
    "test:web-tools-browser": "vitest run src/server/tools/web/agent-browser-poc.test.ts",
    "verify:web-tools-browser": "tsx scripts/verify-web-tools-agent-browser.ts",
    "baseline:web-tools-browser": "tsx scripts/measure-web-tools-baseline.ts",
    "verify:web-tools-release": "npm run typecheck && npm test && npm run build && npm run verify:web-tools-browser && npm run baseline:web-tools-browser",
    "typecheck:skills": "tsc --noEmit -p tsconfig.skills.json",
    "test:skills:unit": "vitest run src/server/skills src/server/db/repositories/skill-package.repo.test.ts src/server/db/skill-runtime-invariants.test.ts --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:skills:integration": "vitest run src/server/http/routes/skill-package-runtime.test.ts src/server/http/routes/skill-package-runtime.p2.test.ts src/server/http/routes/skill-package-runtime.p2-002.test.ts src/server/http/routes/skill-creator.p2-003.test.ts src/server/http/routes/skill-runtime-observability.test.ts src/server/http/routes/skill-runtime.routes.test.ts src/server/db/skill-runtime-invariants.test.ts src/server/db/schema-contract.test.ts tests/integration/skill-runtime --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:skills:e2e": "vitest run tests/e2e/skills --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:skills:security": "vitest run src/server/skills/security/skill-security.test.ts src/server/skills/security/security-audit.service.test.ts src/server/skills/filesystem/skill-path-policy.test.ts src/server/skills/packages/package-path-policy.test.ts src/server/skills/packages/package-reader.test.ts src/server/skills/packages/npx-artifact-detector.test.ts src/server/skills/packages/github-source.test.ts src/server/skills/packages/manifest-resolver.test.ts src/server/skills/packages/package-install-review.service.test.ts src/server/skills/policy/capability-policy.test.ts src/server/skills/policy/capability-broker.test.ts src/server/skills/policy/capability-broker.integration.test.ts src/server/skills/artifacts/artifact-security.test.ts src/server/skills/migration/secret-redactor.test.ts src/server/http/routes/skill-security.test.ts src/server/http/p4-002-legacy-boundary.test.ts tests/security --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:skills:migration": "vitest run src/server/db --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:skills:release-gate": "npm run lint && npm run typecheck:skills && npm run test:skills:unit && npm run test:skills:integration && npm run test:skills:security && npm run test:skills:migration && npm run test:skills:e2e && npm run test:skills:migration:smoke",
    "verify:skills-legacy-migration-offline": "tsx scripts/verify-legacy-skills-migration.ts",
    "verify:legacy-skills-migration": "npm run verify:skills-legacy-migration-offline",
    "test:skills:migration:offline": "npm run typecheck:skills && npm run verify:skills-legacy-migration-offline",
    "test:skills:migration:smoke": "npm run test:skills:migration:offline"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.91",
    "@ai-sdk/openai": "^3.0.79",
    "@ai-sdk/openai-compatible": "^2.0.55",
    "@ai-sdk/react": "^3.0.219",
    "@anthropic-ai/sdk": "^0.26.0",
    "@mastra/agent-browser": "0.4.1",
    "@mastra/ai-sdk": "^1.6.0",
    "@mastra/core": "1.51.0",
    "@mastra/libsql": "1.16.0",
    "@mastra/memory": "^1.22.1",
    "@mastra/observability": "1.16.0",
    "@mastra/otel-bridge": "^1.4.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "ai": "^6.0.217",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-beta.16-c2458b2",
    "js-yaml": "^4.2.0",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "^2.3.0",
    "undici": "^8.5.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "drizzle-kit": "^1.0.0-beta.17-8a36f93",
    "electron": "^37.10.3",
    "electron-builder": "^24.13.3",
    "prettier": "^3.2.5",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "build": {
    "appId": "com.bloomai.app",
    "productName": "BloomAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "scripts/migrations/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icons/bloomai.ico"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/playwright-core/**",
      "**/node_modules/@mastra/agent-browser/**",
      "**/node_modules/agent-browser/**"
    ]
  }
}
